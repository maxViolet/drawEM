<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DrawEM.App\DrawEM.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- BuiltInEffectAnimationsTests checks the source and license record of every built-in effect file. -->
    <None Include="..\..\src\DrawEM.App\Presentation\Effects\BuiltIn\SOURCES.md" Link="BuiltInEffects\SOURCES.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- ReleaseScriptsTests runs the scripts that the release workflow uses. -->
    <None Include="..\..\tools\release\*.ps1" LinkBase="release" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
