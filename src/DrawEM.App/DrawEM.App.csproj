<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Rendered from Assets\drawEM.svg; used by the executable, the tray icon, and the Settings window. -->
    <ApplicationIcon>Assets\drawEM.ico</ApplicationIcon>
    <!-- WFAC010 targets WinForms-hosted apps. WPF owns this process and reads DPI awareness only from app.manifest; WinForms is used for NotifyIcon alone. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- Velopack installs to %LocalAppData%\<id> and deletes that folder on uninstall, so the ID must never be
         the settings folder name drawEM. The release workflows read it with -getProperty:VelopackPackId.
         Never change it after the first release that ships the installer. -->
    <VelopackPackId>drawEM.Desktop</VelopackPackId>
  </PropertyGroup>

  <ItemGroup>
    <!-- VelopackPackageIdentityTests reads the ID from here, so the test and vpk pack use one value. -->
    <AssemblyMetadata Include="VelopackPackId" Value="$(VelopackPackId)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Program.Main runs Velopack's hooks before WPF starts. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\drawEM.ico" />
    <EmbeddedResource Include="Presentation\Effects\BuiltIn\*.json" />
    <!-- The Lottie Simple License requires every distribution of the files to carry its terms. -->
    <None Include="Presentation\Effects\BuiltIn\LICENSE.md" Link="licenses\lottie-effects-license.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Presentation\Effects\BuiltIn\SOURCES.md" Link="licenses\lottie-effects-sources.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp.Skottie" Version="4.153.1" />
    <!-- Same version as the vpk tool in .config/dotnet-tools.json. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
