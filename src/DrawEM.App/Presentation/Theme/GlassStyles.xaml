<ResourceDictionary x:Class="DrawEM.App.Presentation.Theme.GlassStyles"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <!-- Control styles of the glass look. Every color comes from GlassDark or GlassLight through
         DynamicResource, so swapping that dictionary changes the theme. -->

    <Style x:Key="Glass.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource Glass.Focus}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buttons: translucent fill, faint edge, and a light line along the top. -->
    <Style x:Key="Glass.ButtonBase" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource Glass.Foreground}" />
        <Setter Property="Background" Value="{DynamicResource Glass.Button}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Glass.Edge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="12,3" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Glass.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Body" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <Border CornerRadius="5" Background="{DynamicResource Glass.GlowTop}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Glass.ButtonHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Glass.ButtonPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource Glass.ButtonBase}" />

    <Style TargetType="RepeatButton" BasedOn="{StaticResource Glass.ButtonBase}">
        <Setter Property="Padding" Value="0" />
        <!-- Steppers stack two small buttons beside a field, so they set their own height. -->
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- The one main action, Save: the accent fill with a soft glow around it. -->
    <Style x:Key="Glass.PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource Glass.OnAccent}" />
        <Setter Property="Background" Value="{DynamicResource Glass.Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#FF4500" BlurRadius="14" ShadowDepth="2" Opacity="0.35" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Glass.AccentHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Effect" Value="{x:Null}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Text boxes: a sunken field. -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Glass.Foreground}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Glass.Foreground}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Glass.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Glass.Field}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Glass.Edge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Body" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- The field looks sunken: a shade along its top edge. -->
                            <Border CornerRadius="5" Height="4" VerticalAlignment="Top" Background="{DynamicResource Glass.FieldSink}"
                                    Opacity="0.6" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Glass.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check boxes: a small glass box with a check mark. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Glass.Foreground}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Glass.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" VerticalAlignment="Center"
                                Background="{DynamicResource Glass.Field}" BorderBrush="{DynamicResource Glass.Edge}" BorderThickness="1">
                            <!-- Drawn from the origin so the alignment centers it inside the border. -->
                            <Path x:Name="Mark" Data="M 0 3.5 L 3 6.5 L 9 0" Stroke="{DynamicResource Glass.OnAccent}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Glass.Accent}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Glass.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Combo boxes: a glass button with an arrow, and an opaque drop-down. -->
    <Style x:Key="Glass.ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Body" CornerRadius="6" Background="{DynamicResource Glass.Button}"
                            BorderBrush="{DynamicResource Glass.Edge}" BorderThickness="1" SnapsToDevicePixels="True">
                        <Border CornerRadius="5" Background="{DynamicResource Glass.GlowTop}">
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                  Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource Glass.Muted}" StrokeThickness="1.5" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Glass.ButtonHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Glass.Foreground}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Glass.FocusVisual}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource Glass.ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Margin="9,0,22,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Fade" VerticalOffset="4"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,0,8,8" CornerRadius="8" Padding="4"
                                    Background="{DynamicResource Glass.Popup}" BorderBrush="{DynamicResource Glass.Edge}" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.3" />
                                </Border.Effect>
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Glass.Foreground}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Body" CornerRadius="5" Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Glass.ButtonHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Glass.TabSelected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tabs: a row of pill headers; the selected one is a raised glass pill. -->
    <Style TargetType="TabControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <TabPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="0,0,0,4" />
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                          Margin="{TemplateBinding Padding}" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Glass.Muted}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Glass.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Body" CornerRadius="7" Padding="12,6" Margin="0,0,4,0" Background="Transparent"
                            BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Glass.ButtonPressed}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Glass.Foreground}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Glass.TabSelected}" />
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Glass.Edge}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Scroll bars: a thin rounded thumb on a clear track. -->
    <Style x:Key="Glass.ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Glass.ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Body" CornerRadius="3" Background="{DynamicResource Glass.Muted}" Opacity="0.5" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,2,2,2">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource Glass.ScrollPage}" Command="ScrollBar.PageUpCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource Glass.ScrollThumb}" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource Glass.ScrollPage}" Command="ScrollBar.PageDownCommand" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" Margin="2">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Glass.ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Glass.ScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Glass.ScrollPage}" Command="ScrollBar.PageRightCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The dark/light switch: a sunken track with a glowing thumb that shows a moon or a sun. -->
    <Style x:Key="Glass.ThemeSwitch" TargetType="ToggleButton">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Glass.FocusVisual}" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border CornerRadius="11" Background="{DynamicResource Glass.Field}" BorderBrush="{DynamicResource Glass.Edge}"
                            BorderThickness="1">
                        <Border x:Name="Thumb" Width="16" Height="16" CornerRadius="8" Margin="2,0" HorizontalAlignment="Left"
                                Background="{DynamicResource Glass.ButtonHover}" BorderBrush="{DynamicResource Glass.Edge}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="White" BlurRadius="8" ShadowDepth="0" Opacity="0.35" />
                            </Border.Effect>
                            <Grid>
                                <Path x:Name="Moon" Width="9" Height="9" Stretch="Uniform" Fill="{DynamicResource Glass.Foreground}"
                                      Data="M 21 12.8 A 9 9 0 1 1 11.2 3 A 7 7 0 0 0 21 12.8 Z" />
                                <Path x:Name="Sun" Width="10" Height="10" Stretch="Uniform" Visibility="Collapsed"
                                      Stroke="{DynamicResource Glass.Foreground}" StrokeThickness="1.4"
                                      Data="M 12 8 A 4 4 0 1 1 11.99 8 Z M 12 1 V 4 M 12 20 V 23 M 1 12 H 4 M 20 12 H 23 M 4.2 4.2 L 6.3 6.3 M 17.7 17.7 L 19.8 19.8 M 4.2 19.8 L 6.3 17.7 M 17.7 6.3 L 19.8 4.2" />
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Moon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Sun" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Title bar buttons: minimize, maximize, and close, drawn by the window itself. -->
    <Style x:Key="Glass.CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="{DynamicResource Glass.Foreground}" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Body" Background="Transparent" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Glass.ButtonHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Glass.CloseButton" TargetType="Button" BasedOn="{StaticResource Glass.CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Body" Background="Transparent" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Glass.CloseHover}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tooltips open in their own window, so they use the opaque popup surface. -->
    <Style x:Key="Glass.ToolTip" TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Glass.Foreground}" />
        <Setter Property="Background" Value="{DynamicResource Glass.Popup}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Glass.Edge}" />
    </Style>
</ResourceDictionary>
