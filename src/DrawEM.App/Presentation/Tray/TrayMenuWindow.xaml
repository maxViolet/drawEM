<Window x:Class="DrawEM.App.Presentation.Tray.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:DrawEM.App.Presentation.Theme"
        Title="drawEM"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Foreground="{DynamicResource Glass.Foreground}"
        Background="{DynamicResource Glass.SurfaceSolid}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The theme's brushes come first; GlassBackdrop swaps this one when the theme changes. -->
                <theme:GlassDark />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Item" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource Glass.Foreground}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Body" CornerRadius="6" Padding="10,7" Background="Transparent">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Body" Property="Background" Value="{DynamicResource Glass.ButtonHover}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Body" Property="Background" Value="{DynamicResource Glass.ButtonHover}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Body" Property="Background" Value="{DynamicResource Glass.ButtonPressed}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Exit lights up in the accent color, as the command that ends the app. -->
            <Style x:Key="ExitItem" TargetType="Button" BasedOn="{StaticResource Item}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Body" CornerRadius="6" Padding="10,7" Background="Transparent">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Body" Property="Background" Value="{DynamicResource Glass.ExitHover}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Body" Property="Background" Value="{DynamicResource Glass.ExitHover}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Glyph" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Width" Value="16" />
                <Setter Property="Margin" Value="0,0,12,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Opacity" Value="0.8" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- The menu surface: translucent over the system backdrop, with a faint edge and an inner glow. -->
    <Border Background="{DynamicResource Glass.Surface}" BorderBrush="{DynamicResource Glass.Edge}" BorderThickness="1">
        <Border Background="{DynamicResource Glass.GlowInner}">
            <Border Background="{DynamicResource Glass.GlowTop}" Padding="5">
                <StackPanel Width="200" KeyboardNavigation.DirectionalNavigation="Cycle"
                            KeyboardNavigation.TabNavigation="Cycle">
                    <Button x:Name="SettingsItem" Style="{StaticResource Item}" Click="OnSettings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" />
                            <TextBlock x:Name="SettingsText" Text="Settings…" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Glass.Foreground}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopEffectsItem" Style="{StaticResource Item}" Click="OnStopEffects">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE71A;" />
                            <TextBlock Text="Stop effects" />
                        </StackPanel>
                    </Button>
                    <Border Height="1" Margin="10,4" Background="{DynamicResource Glass.Edge}" />
                    <Button x:Name="ExitItem" Style="{StaticResource ExitItem}" Click="OnExit">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7E8;" />
                            <TextBlock Text="Exit" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Border>
    </Border>
</Window>
