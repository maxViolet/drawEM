<Window x:Class="DrawEM.App.Presentation.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="drawEM Settings"
        Width="680"
        Height="640"
        MinWidth="560"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="White">
    <Window.Resources>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A92F16" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#647080" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,12" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#414B58" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,3" />
        </Style>
        <Style x:Key="CaptureField" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Content" Value="{Binding Text}" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <Setter Property="ToolTip" Value="Click, then press the shortcut. Escape cancels." />
            <EventSetter Event="Click" Handler="OnCaptureClick" />
            <EventSetter Event="GotKeyboardFocus" Handler="OnCaptureFocus" />
            <EventSetter Event="LostKeyboardFocus" Handler="OnCaptureFocusLost" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                    <Setter Property="FontStyle" Value="Italic" />
                    <Setter Property="BorderBrush" Value="#EF5630" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#FAFBFC" BorderBrush="#E2E5EA" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel LastChildFill="False">
                <Button x:Name="RestoreDefaultsButton" DockPanel.Dock="Left" Content="Restore defaults" Click="OnRestoreDefaults" />
                <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Save" MinWidth="80" Margin="8,0,0,0"
                        IsDefault="True" IsEnabled="{Binding CanSave}" Click="OnSave" />
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" MinWidth="80" Margin="8,0,0,0"
                        IsCancel="True" Click="OnCancel" />
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Hint}"
                           Text="Changes take effect after Save" />
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,8">
            <TextBlock x:Name="StatusText" Style="{StaticResource ErrorText}" Text="{Binding Status}" />
            <TextBlock x:Name="ErrorsText" Style="{StaticResource ErrorText}" Text="{Binding Errors}" />
        </StackPanel>

        <TabControl x:Name="Tabs" Margin="12,12,12,8" Padding="12">
            <TabItem Header="Drawing">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Stroke" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Applied to new strokes. Width is measured in physical pixels." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Label}" Text="Color · HEX" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="HexBox" Width="100" VerticalContentAlignment="Center" MinHeight="30"
                                             MaxLength="7" AutomationProperties.Name="Color HEX"
                                             Text="{Binding HexText, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button x:Name="PickColorButton" Content="Pick…" Margin="6,0,0,0" Click="OnPickColor" />
                                    <Border Width="48" Height="6" CornerRadius="3" Margin="10,0,0,0"
                                            VerticalAlignment="Center" Background="{Binding Color}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding HexError}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Label}" Text="Line width · 1–20 px" />
                                <TextBox x:Name="WidthBox" Width="100" HorizontalAlignment="Left" MinHeight="30"
                                         VerticalContentAlignment="Center" AutomationProperties.Name="Line width"
                                         Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding WidthError}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Shortcuts" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,0" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Click a shortcut, then hold at least two of Ctrl, Left Alt, and Shift and press a letter, digit, or F1–F12. Right Alt is reserved for AltGr. Escape cancels." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" DataContext="{Binding Draw}">
                                <TextBlock Style="{StaticResource Label}" Text="Hold to draw" />
                                <Button x:Name="DrawShortcutButton" Style="{StaticResource CaptureField}"
                                        AutomationProperties.Name="Hold to draw shortcut" />
                                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" DataContext="{Binding Clear}">
                                <TextBlock Style="{StaticResource Label}" Text="Clear current monitor" />
                                <Button x:Name="ClearShortcutButton" Style="{StaticResource CaptureField}"
                                        AutomationProperties.Name="Clear shortcut" />
                                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Actions · 8 slots">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="#FF5A32" BorderThickness="3,0,0,0" Background="#FFF3ED"
                            Padding="10,8" Margin="0,0,0,10">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#694332"
                                   Text="One sound plays at a time. Sample plays a draft file for up to 10 seconds; changing a slot does not affect shortcuts until Save." />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SlotList" ItemsSource="{Binding Slots}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E0E5EB" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="Bold"
                                                       Foreground="#B63C1C" VerticalAlignment="Top" Margin="0,6,0,0" />
                                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FileName}" Margin="0,0,0,4" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="{Binding ChooseText}" Click="OnChooseFile" MinHeight="26" />
                                                    <Button Content="Remove" Click="OnRemoveSound" Margin="6,0,0,0" MinHeight="26"
                                                            IsEnabled="{Binding HasSound}" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Message}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" DataContext="{Binding Shortcut}">
                                                <Button Style="{StaticResource CaptureField}" AutomationProperties.Name="Slot shortcut" />
                                                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}" />
                                            </StackPanel>
                                            <Button Grid.Column="3" Content="Sample" Click="OnSample" Margin="8,0,0,0"
                                                    VerticalAlignment="Top" IsEnabled="{Binding HasSound}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
