<Window x:Class="DrawEM.App.Presentation.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DrawEM.App.Presentation.Settings"
        xmlns:theme="clr-namespace:DrawEM.App.Presentation.Theme"
        Title="drawEM Settings"
        Width="816"
        Height="768"
        MinWidth="672"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Foreground="{DynamicResource Glass.Foreground}"
        Background="{DynamicResource Glass.SurfaceSolid}"
        Icon="pack://application:,,,/DrawEM.App;component/Assets/drawEM.ico">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <!-- The theme's brushes come first; GlassBackdrop swaps this one when the theme changes. -->
            <theme:GlassDark />
            <theme:GlassStyles />
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <!-- The whole window is drawn 20% larger. A drop-down takes the scale of its combo box, but a tooltip
             does not, so the tooltip style applies it. The window's default height is cut to the work area in code. -->
        <ScaleTransform x:Key="UiScale" ScaleX="1.2" ScaleY="1.2" />
        <Style TargetType="ToolTip" BasedOn="{StaticResource Glass.ToolTip}">
            <Setter Property="LayoutTransform" Value="{StaticResource UiScale}" />
        </Style>
        <!-- One shared view; each list sets IsSynchronizedWithCurrentItem="False" so rows select independently. -->
        <CollectionViewSource x:Key="EffectOptions" Source="{x:Static local:EffectOption.All}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Glass.Error}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Glass.Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,12" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Glass.Muted}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="CaptureField" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource Glass.Field}" />
            <Setter Property="Content" Value="{Binding Text}" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <Setter Property="ToolTip" Value="Click, then press the shortcut. Escape cancels." />
            <EventSetter Event="Click" Handler="OnCaptureClick" />
            <EventSetter Event="GotKeyboardFocus" Handler="OnCaptureFocus" />
            <EventSetter Event="LostKeyboardFocus" Handler="OnCaptureFocusLost" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                    <Setter Property="FontStyle" Value="Italic" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Glass.Accent}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A slot card and the Max length value: a glass panel with a faint edge. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Glass.Field}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Glass.Edge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- The window surface: translucent over the system backdrop, with a faint edge and an inner glow. -->
    <Border x:Name="Frame" Background="{DynamicResource Glass.Surface}" BorderBrush="{DynamicResource Glass.Edge}" BorderThickness="1">
    <Border Background="{DynamicResource Glass.GlowInner}">
    <Border Background="{DynamicResource Glass.GlowTop}">
    <DockPanel LayoutTransform="{StaticResource UiScale}">
        <DockPanel x:Name="TitleBar" DockPanel.Dock="Top" Height="36" Margin="14,0,4,0">
            <Image DockPanel.Dock="Left" Width="16" Height="16" VerticalAlignment="Center"
                   Source="pack://application:,,,/DrawEM.App;component/Assets/drawEM.ico" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="ThemeSwitch" Style="{StaticResource Glass.ThemeSwitch}" Margin="0,0,10,0"
                              AutomationProperties.Name="Light theme" ToolTip="Light theme"
                              Checked="OnThemeSwitched" Unchecked="OnThemeSwitched" />
                <Button Style="{StaticResource Glass.CaptionButton}" Content="&#xE921;" Click="OnMinimize"
                        AutomationProperties.Name="Minimize" />
                <Button x:Name="MaximizeButton" Style="{StaticResource Glass.CaptionButton}" Content="&#xE922;" Click="OnMaximize"
                        AutomationProperties.Name="Maximize" />
                <Button Style="{StaticResource Glass.CloseButton}" Content="&#xE8BB;" Click="OnCancel"
                        AutomationProperties.Name="Close" />
            </StackPanel>
            <TextBlock Text="drawEM Settings" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource Glass.Muted}" />
        </DockPanel>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Glass.Footer}" BorderBrush="{DynamicResource Glass.Edge}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel LastChildFill="False">
                <Button x:Name="RestoreDefaultsButton" DockPanel.Dock="Left" Content="Restore defaults" Click="OnRestoreDefaults" />
                <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Save" MinWidth="80" Margin="8,0,0,0"
                        Style="{StaticResource Glass.PrimaryButton}"
                        IsDefault="True" IsEnabled="{Binding CanSave}" Click="OnSave" />
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" MinWidth="80" Margin="8,0,0,0"
                        IsCancel="True" Click="OnCancel" />
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Hint}"
                           Text="Changes take effect after Save" />
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,8">
            <TextBlock x:Name="StatusText" Style="{StaticResource ErrorText}" Text="{Binding Status}" />
            <TextBlock x:Name="ErrorsText" Style="{StaticResource ErrorText}" Text="{Binding Errors}" />
        </StackPanel>

        <TabControl x:Name="Tabs" Margin="16,4,16,8" Padding="4,12,4,0">
            <TabItem Header="Drawing">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Stroke" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Applied to new strokes. Width is measured in physical pixels." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Label}" Text="Color · HEX" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="HexBox" Width="100" VerticalContentAlignment="Center" MinHeight="30"
                                             MaxLength="7" AutomationProperties.Name="Color HEX"
                                             Text="{Binding HexText, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button x:Name="PickColorButton" Content="Pick…" Margin="6,0,0,0" Click="OnPickColor" />
                                    <Border Width="48" Height="6" CornerRadius="3" Margin="10,0,0,0"
                                            VerticalAlignment="Center" Background="{Binding Color}">
                                        <!-- The swatch glows in its own color. -->
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.8"
                                                              Color="{Binding Color}" />
                                        </Border.Effect>
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding HexError}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Label}" Text="Line width · 1–20 px" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="WidthBox" Width="100" MinHeight="30"
                                             VerticalContentAlignment="Center" AutomationProperties.Name="Line width"
                                             PreviewKeyDown="OnWidthKeyDown"
                                             Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Margin="4,0,0,0">
                                        <RepeatButton x:Name="IncreaseWidthButton" Width="24" Height="15" Padding="0"
                                                      FontFamily="Segoe MDL2 Assets" FontSize="8" Content="&#xE70E;"
                                                      AutomationProperties.Name="Increase line width" ToolTip="Wider (Up)"
                                                      IsEnabled="{Binding CanIncreaseWidth}" Click="OnIncreaseWidth" />
                                        <RepeatButton x:Name="DecreaseWidthButton" Width="24" Height="15" Padding="0"
                                                      FontFamily="Segoe MDL2 Assets" FontSize="8" Content="&#xE70D;"
                                                      AutomationProperties.Name="Decrease line width" ToolTip="Thinner (Down)"
                                                      IsEnabled="{Binding CanDecreaseWidth}" Click="OnDecreaseWidth" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding WidthError}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Shortcuts" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,0" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Click a shortcut, then hold at least two of Ctrl, Left Alt, and Shift and press a letter, digit, or F1–F12. Right Alt is reserved for AltGr. Escape cancels." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" DataContext="{Binding Draw}">
                                <TextBlock Style="{StaticResource Label}" Text="Hold to draw" />
                                <Button x:Name="DrawShortcutButton" Style="{StaticResource CaptureField}"
                                        AutomationProperties.Name="Hold to draw shortcut" />
                                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" DataContext="{Binding Clear}">
                                <TextBlock Style="{StaticResource Label}" Text="Clear current monitor" />
                                <Button x:Name="ClearShortcutButton" Style="{StaticResource CaptureField}"
                                        AutomationProperties.Name="Clear shortcut" />
                                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Actions · 8 slots">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Glass.Edge}" BorderThickness="1" CornerRadius="8"
                            Background="{DynamicResource Glass.Info}" Padding="12,8" Margin="0,0,0,10">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Glass.InfoForeground}"
                                   Text="One sound and one effect play at a time. Each slot plays a sound or shows an effect; an effect's placement comes with it. Sample uses the draft effect's Loop and Max length settings on the monitor with the cursor; changing a slot does not affect shortcuts until Save." />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SlotList" ItemsSource="{Binding Slots}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="Bold"
                                                       Foreground="{DynamicResource Glass.SlotLabel}" VerticalAlignment="Top" Margin="0,6,0,0" />
                                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <ComboBox ItemsSource="{x:Static local:SlotViewModel.Kinds}" Width="80" MinHeight="26"
                                                              SelectedItem="{Binding Kind, Mode=OneWay}" SelectionChanged="OnKindChanged"
                                                              AutomationProperties.Name="Action type" />
                                                    <ComboBox ItemsSource="{Binding Source={StaticResource EffectOptions}}"
                                                              IsSynchronizedWithCurrentItem="False" DisplayMemberPath="Name"
                                                              SelectedItem="{Binding Effect}" Width="150" MinHeight="26" Margin="6,0,0,0"
                                                              Visibility="{Binding IsEffect, Converter={StaticResource Visible}}"
                                                              AutomationProperties.Name="Effect">
                                                        <ComboBox.GroupStyle>
                                                            <GroupStyle>
                                                                <GroupStyle.HeaderTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                                                                   Foreground="{DynamicResource Glass.Muted}" Margin="4,4,4,2" />
                                                                    </DataTemplate>
                                                                </GroupStyle.HeaderTemplate>
                                                            </GroupStyle>
                                                        </ComboBox.GroupStyle>
                                                    </ComboBox>
                                                    <Button Content="{Binding ChooseText}" Click="OnChooseFile" MinHeight="26" Margin="6,0,0,0"
                                                            Visibility="{Binding IsSound, Converter={StaticResource Visible}}" />
                                                    <Button Content="Clear" Click="OnClearSlot" Margin="6,0,0,0" MinHeight="26"
                                                            IsEnabled="{Binding HasAction}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                            Visibility="{Binding HasEffect, Converter={StaticResource Visible}}">
                                                    <CheckBox Content="Loop" VerticalAlignment="Center"
                                                              AutomationProperties.Name="Loop effect"
                                                              IsChecked="{Binding Loop}" />
                                                    <TextBlock Text="Max length:" VerticalAlignment="Center" Margin="16,0,6,0" />
                                                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanEditMaxLength}">
                                                        <Border MinWidth="42" Height="26" Padding="6,0" Style="{StaticResource Card}"
                                                                CornerRadius="6">
                                                            <TextBlock Text="{Binding MaxLengthText}" VerticalAlignment="Center"
                                                                       HorizontalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Margin="4,0,0,0">
                                                            <RepeatButton Width="24" Height="13" Padding="0"
                                                                          FontFamily="Segoe MDL2 Assets" FontSize="8" Content="&#xE70E;"
                                                                          AutomationProperties.Name="Increase max length"
                                                                          ToolTip="Longer"
                                                                          IsEnabled="{Binding CanIncreaseMaxLength}"
                                                                          Click="OnIncreaseMaxLength" />
                                                            <RepeatButton Width="24" Height="13" Padding="0"
                                                                          FontFamily="Segoe MDL2 Assets" FontSize="8" Content="&#xE70D;"
                                                                          AutomationProperties.Name="Decrease max length"
                                                                          ToolTip="Shorter"
                                                                          IsEnabled="{Binding CanDecreaseMaxLength}"
                                                                          Click="OnDecreaseMaxLength" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <CheckBox Content="No limit" VerticalAlignment="Center" Margin="12,0,0,0"
                                                              AutomationProperties.Name="No effect length limit"
                                                              IsEnabled="{Binding CanSetNoLimit}"
                                                              IsChecked="{Binding NoLimit}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FileName}" Margin="0,4,0,0"
                                                           Visibility="{Binding IsSound, Converter={StaticResource Visible}}" />
                                                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Message}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" DataContext="{Binding Shortcut}">
                                                <Button Style="{StaticResource CaptureField}" AutomationProperties.Name="Slot shortcut" />
                                                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}" />
                                            </StackPanel>
                                            <Button Grid.Column="3" Content="{Binding SampleText}" Click="OnSample" Margin="8,0,0,0"
                                                    VerticalAlignment="Top" IsEnabled="{Binding HasAction}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem Header="Developer settings">
                <StackPanel Margin="4">
                    <TextBlock Text="Drawing" FontSize="15" FontWeight="SemiBold" />
                    <CheckBox Content="Bezier smoothing" Margin="0,12,0,0"
                              AutomationProperties.Name="Bezier smoothing"
                              IsChecked="{Binding BezierSmoothing}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
    </Border>
    </Border>
    </Border>
</Window>
